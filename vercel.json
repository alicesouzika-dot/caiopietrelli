{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|splash/|manifest\\.webmanifest|sw\\.js|workbox-.*\\.js|registerSW\\.js).*)",
      "destination": "/index.html"
    }
  ]
}

